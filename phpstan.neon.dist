parameters:
    level: 10
    phpVersion: 80100
    paths:
        - registration.php
        - functions.php
        - Api
        - Block
        - Exception
        - Model
        - Observer
        - Plugin
        - View
        - Test
    stubFiles:
        - phpstan/Serialize.stub
    bootstrapFiles:
        - ../../../vendor/autoload.php
    scanDirectories:
        - ../../../generated/code
        - ../../../dev/tests/integration/framework
