    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayMergerInterface"
                type="Hryvinskyi\Base\Model\Arrays\ArrayMerger"/>
    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayIndexerInterface"
                type="Hryvinskyi\Base\Model\Arrays\ArrayIndexer"/>
    <preference for="Hryvinskyi\Base\Api\Arrays\ArraySorterInterface"
                type="Hryvinskyi\Base\Model\Arrays\ArraySorter"/>
    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayInspectorInterface"
                type="Hryvinskyi\Base\Model\Arrays\ArrayInspector"/>
    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayFilterInterface"
