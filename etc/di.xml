    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayPathReaderInterface"
                type="Hryvinskyi\Base\Model\Arrays\ArrayPathReader"/>
    <preference for="Hryvinskyi\Base\Api\Arrays\ArrayPathWriterInterface"
