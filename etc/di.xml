                type="Hryvinskyi\Base\Model\Menu\MenuSectionArranger"/>
    <preference for="Hryvinskyi\Base\Api\LayoutDebugConfigInterface"
                type="Hryvinskyi\Base\Model\LayoutDebugConfig"/>
    <preference for="Hryvinskyi\Base\Api\Json\JsonEncoderInterface"
                type="Hryvinskyi\Base\Model\Json\JsonEncoder"/>
    <preference for="Hryvinskyi\Base\Api\Json\JsonDecoderInterface"
                type="Hryvinskyi\Base\Model\Json\JsonDecoder"/>
    <preference for="Hryvinskyi\Base\Api\Debug\VarDumperInterface"
